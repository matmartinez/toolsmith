{
  "cliServers": {
    "git": {
      "executable": "/usr/bin/git",
      "tools": [
        {
          "name": "status",
          "description": "Show the working tree status (short form).",
          "inputSchema": {
            "type": "object",
            "properties": {},
            "required": []
          },
          "argv": [
            { "literal": "status" },
            { "literal": "--porcelain" }
          ]
        },
        {
          "name": "log",
          "description": "Show commit logs.",
          "inputSchema": {
            "type": "object",
            "properties": {
              "path":    { "type": "string" },
              "limit":   { "type": "integer" },
              "verbose": { "type": "boolean" }
            }
          },
          "argv": [
            { "literal": "log" },
            { "flag": "-n", "argument": "limit" },
            { "booleanFlag": "--stat", "argument": "verbose" },
            { "optionalArgument": "path" }
          ]
        }
      ]
    },
    "files": {
      "executable": "/bin/cat",
      "tools": [],
      "resources": [
        {
          "name": "hosts",
          "uri": "file:///etc/hosts",
          "mimeType": "text/plain",
          "output": "text",
          "argv": [
            { "literal": "/etc/hosts" }
          ]
        }
      ],
      "resourceTemplates": [
        {
          "name": "text-file",
          "uriTemplate": "file-text://{path}",
          "mimeType": "text/plain",
          "output": "text",
          "argv": [
            { "argument": "path" }
          ]
        },
        {
          "name": "binary-file",
          "uriTemplate": "file-bytes://{path}",
          "mimeType": "application/octet-stream",
          "output": "blob",
          "argv": [
            { "argument": "path" }
          ]
        }
      ]
    }
  }
}
